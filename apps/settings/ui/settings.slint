import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView, Slider, SpinBox, Spinner, TextEdit } from "std-widgets.slint";
export { DictionaryWindow } from "dictionary.slint";

export enum RowKind { header, check, choice, slider, spin, text, more }

// One line of a settings column, made by settings.rs from its table.
export struct Row {
    kind: RowKind,
    label: string,
    hint: styled-text,
    advanced: bool,
    enabled: bool,
    checked: bool,
    choices: [string],
    value: int,
    minimum: int,
    maximum: int,
    text: string,
}

// The tables' rows, and what is done to them: a row is told by its table
// and its place there.
export global Settings {
    in property <[[Row]]> tables;
    // One for every tab, as the page had it.
    in-out property <bool> show-advanced;
    callback toggled(int, int, bool);
    callback selected(int, int, int);
    callback valued(int, int, int);
    callback typed(int, int, string);
}

export struct Keybind {
    action: int,
    param: string,
    key: string,
}

export struct Program {
    name: string,
    exe: string,
    // · 已在清單中, or the list it is in instead.
    note: string,
    icon: image,
    has-icon: bool,
    checked: bool,
    // Not already in either list.
    enabled: bool,
    // By the search.
    shown: bool,
}

// The cards' colors. Opaque: a row's card is drawn over the edge of the one
// above, and two translucent lines there would show darker than the rest.
global Card {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> fill: self.dark ? #2B2B2B : #FFFFFF;
    out property <color> stroke: self.dark ? #3A3A3A : #E3E3E3;
    // Under the pointer, and pressed: a tab, which has no card.
    out property <color> hover: self.dark ? #FFFFFF0F : #0000000A;
    out property <color> pressed: self.dark ? #FFFFFF08 : #00000006;
}

// A section of a tab, for switches that touch the same keys or feature; its
// rows are on a card below it.
component Header {
    in property <string> label;
    in property <bool> first;
    HorizontalLayout {
        padding-top: root.first ? 0px : 20px;
        padding-bottom: 8px;
        padding-left: 4px;
        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: 15px;
            font-weight: 600;
        }
    }
}

// A row on its section's card. The table is flat, so the card is drawn a row
// at a time: rounded at the section's first and last rows, and each row's
// edge over the next one's makes the line between them.
component CardRow {
    in property <bool> first;
    in property <bool> last;
    // A checkbox's row as tall as a drop-down's.
    min-height: 36px;
    Rectangle {
        y: 0px;
        height: parent.height + (root.last ? 0px : 1px);
        background: Card.fill;
        border-width: 1px;
        border-color: Card.stroke;
        border-top-left-radius: root.first ? 8px : 0px;
        border-top-right-radius: root.first ? 8px : 0px;
        border-bottom-left-radius: root.last ? 8px : 0px;
        border-bottom-right-radius: root.last ? 8px : 0px;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

// The widgets below take their own clicks and typing, which ends a binding
// to the row: each is set again from the row when settings.rs changes it, by
// a rule or a reset.

component Check {
    in property <Row> item;
    callback toggled(bool);
    changed item => {
        box.checked = root.item.checked;
    }
    HorizontalLayout {
        alignment: start;
        box := CheckBox {
            text: root.item.label;
            enabled: root.item.enabled;
            checked: root.item.checked;
            toggled => {
                root.toggled(self.checked);
            }
            Tooltip {
                text: root.item.hint;
            }
        }
    }
}

component Label inherits Text {
    in property <bool> enabled: true;
    color: Palette.foreground;
    opacity: self.enabled ? 1 : 0.5;
    vertical-alignment: center;
}

component Choice {
    in property <Row> item;
    callback selected(int);
    changed item => {
        box.current-index = root.item.value;
    }
    HorizontalLayout {
        spacing: 8px;
        Label {
            text: root.item.label;
            enabled: root.item.enabled;
            horizontal-stretch: 1;
        }

        // As wide as the longest choice, not the chosen one: the popup takes
        // the box's width and cut the longer ones short. 48px is the popup's
        // padding around an item's text, a bit more than the box's own.
        VerticalLayout {
            box := ComboBox {
                model: root.item.choices;
                current-index: root.item.value;
                enabled: root.item.enabled;
                selected => {
                    root.selected(self.current-index);
                }
            }

            for choice in root.item.choices: Rectangle {
                height: 0px;
                min-width: choice-text.preferred-width + 48px;
                choice-text := Text {
                    text: choice;
                    visible: false;
                }
            }
        }
    }

    Tooltip {
        text: root.item.hint;
    }
}

component Spin {
    in property <Row> item;
    callback edited(int);
    changed item => {
        box.value = root.item.value;
    }
    HorizontalLayout {
        spacing: 8px;
        Label {
            text: root.item.label;
            enabled: root.item.enabled;
            horizontal-stretch: 1;
        }

        box := SpinBox {
            width: 120px;
            minimum: root.item.minimum;
            maximum: root.item.maximum;
            value: root.item.value;
            enabled: root.item.enabled;
            edited(value) => {
                root.edited(value);
            }
        }
    }

    Tooltip {
        text: root.item.hint;
    }
}

component Field {
    in property <Row> item;
    callback edited(string);
    changed item => {
        // Not while typing: the text is the row's already, and setting it
        // again would move the cursor.
        if box.text != root.item.text {
            box.text = root.item.text;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Label {
            min-width: 150px;
            text: root.item.label;
            enabled: root.item.enabled;
            horizontal-stretch: 1;
        }

        box := LineEdit {
            width: 110px;
            text: root.item.text;
            enabled: root.item.enabled;
            edited(text) => {
                root.edited(text);
            }
        }
    }

    Tooltip {
        text: root.item.hint;
    }
}

component Sensitivity {
    in property <Row> item;
    callback moved(int);
    changed item => {
        bar.value = root.item.value;
    }
    VerticalLayout {
        spacing: 4px;
        padding-top: 4px;
        Text {
            text: root.item.label;
            color: Palette.foreground;
        }

        bar := Slider {
            minimum: 100;
            maximum: 1000;
            step: 100;
            value: root.item.value;
            changed(value) => {
                root.moved(Math.round(value));
            }
        }
    }

    Tooltip {
        text: root.item.hint;
    }
}

// 進階設定, showing the rows marked advanced; it opens from the keyboard too.
component More {
    in property <string> label;
    in-out property <bool> open;
    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => {
        root.open = !root.open;
    }
    HorizontalLayout {
        alignment: start;
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == Key.Return {
                    root.open = !root.open;
                    return accept;
                }
                reject
            }
            Rectangle {
                border-radius: 4px;
                border-width: focus.has-focus ? 1px : 0px;
                border-color: Palette.foreground;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = !root.open;
                    focus.focus();
                }
            }

            // Drawn: the fonts Chinese falls back to have no ▸.
            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.open ? @image-url("chevron-down.svg") : @image-url("chevron-right.svg");
                        colorize: Palette.foreground;
                        width: 12px;
                        height: 12px;
                    }
                }

                Text {
                    text: root.label;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The rows of one table in Settings.tables.
component Column {
    in property <int> table;
    // Below other content on the page: its first section keeps the gap
    // above a section.
    in property <bool> follows;
    VerticalLayout {
        alignment: start;
        for row[index] in Settings.tables[root.table]: line := VerticalLayout {
            property <bool> shown: row.kind == RowKind.more || !row.advanced || Settings.show-advanced;
            // A header starts a card; the advanced rows, which follow 進階設定
            // to the end of their section, end it there while closed.
            property <Row> next: Settings.tables[root.table][index + 1];
            property <bool> first: index == 0 || Settings.tables[root.table][index - 1].kind == RowKind.header;
            property <bool> last: index + 1 >= Settings.tables[root.table].length || line.next.kind == RowKind.header || (line.next.advanced && !Settings.show-advanced);
            if line.shown && row.kind == RowKind.header: Header {
                label: row.label;
                first: index == 0 && !root.follows;
            }
            if line.shown && row.kind != RowKind.header: CardRow {
                first: line.first;
                last: line.last;
                if row.kind == RowKind.check: Check {
                    item: row;
                    toggled(on) => {
                        Settings.toggled(root.table, index, on);
                    }
                }
                if row.kind == RowKind.choice: Choice {
                    item: row;
                    selected(choice) => {
                        Settings.selected(root.table, index, choice);
                    }
                }
                if row.kind == RowKind.slider: Sensitivity {
                    item: row;
                    moved(value) => {
                        Settings.valued(root.table, index, value);
                    }
                }
                if row.kind == RowKind.spin: Spin {
                    item: row;
                    edited(value) => {
                        Settings.valued(root.table, index, value);
                    }
                }
                if row.kind == RowKind.text: Field {
                    item: row;
                    edited(text) => {
                        Settings.typed(root.table, index, text);
                    }
                }
                if row.kind == RowKind.more: More {
                    label: row.label;
                    open <=> Settings.show-advanced;
                }
            }
        }
    }
}

// A file edited in full: program lists, symbol tables, phrases.
component Editor inherits TextEdit {
    font-family: "Consolas";
    vertical-stretch: 1;
    // TextEdit scrolls to keep the cursor 20px clear of its bottom edge. The
    // window is laid out once at its least height, which the scrolling tabs
    // made small: below 20px, the cursor at the top counted as out of view,
    // and the symbol table opened scrolled down.
    min-height: 120px;
}

component Help inherits Text {
    color: Palette.foreground;
    wrap: word-wrap;
}

component KeybindHeader {
    in property <string> label;
    in property <styled-text> hint;
    Text {
        text: root.label;
        color: Palette.foreground;
        font-weight: 600;
    }

    Tooltip {
        text: root.hint;
    }
}

component KeybindRow {
    in property <Keybind> item;
    in property <[string]> actions;
    callback action(int);
    callback param(string);
    callback key(string);
    callback remove();
    changed item => {
        chosen.current-index = root.item.action;
        if param.text != root.item.param {
            param.text = root.item.param;
        }
        if key.text != root.item.key {
            key.text = root.item.key;
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        padding-bottom: 6px;
        chosen := ComboBox {
            width: 200px;
            model: root.actions;
            current-index: root.item.action;
            selected => {
                root.action(self.current-index);
            }
        }

        param := LineEdit {
            width: 200px;
            text: root.item.param;
            edited(text) => {
                root.param(text);
            }
        }

        key := LineEdit {
            width: 200px;
            text: root.item.key;
            edited(text) => {
                root.key(text);
            }
        }

        Button {
            icon: @image-url("delete.svg");
            colorize-icon: true;
            accessible-label: "刪除";
            clicked => {
                root.remove();
            }
        }
    }
}

component PickRow {
    in property <Program> item;
    callback toggled(bool);
    changed item => {
        box.checked = root.item.checked;
    }
    height: root.item.shown ? 34px : 0px;
    visible: root.item.shown;
    // The name and file pick it too, as a checkbox's label does.
    TouchArea {
        enabled: root.item.enabled;
        clicked => {
            box.checked = !box.checked;
            root.toggled(box.checked);
        }
    }

    HorizontalLayout {
        spacing: 8px;
        box := CheckBox {
            checked: root.item.checked;
            enabled: root.item.enabled;
            toggled => {
                root.toggled(self.checked);
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: root.item.has-icon ? root.item.icon : @image-url("app.svg");
                colorize: root.item.has-icon ? transparent : Palette.foreground;
                width: 20px;
                height: 20px;
            }
        }

        Label {
            text: root.item.name;
            enabled: root.item.enabled;
        }

        Label {
            text: root.item.exe + root.item.note;
            font-size: 12px;
            opacity: 0.6;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// A tab of TabBar.
component TabButton {
    in property <string> title;
    in property <bool> current;
    in property <bool> focused;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    accessible-action-default => {
        root.clicked();
    }
    min-height: 34px;
    horizontal-stretch: 0;
    // Opening into the page: the bottom edge is clipped off, and the fill
    // covers the line the other tabs stand on.
    if root.current: Rectangle {
        clip: true;
        Rectangle {
            y: 0px;
            height: parent.height + 8px;
            background: Card.fill;
            border-width: 1px;
            border-color: Card.stroke;
            border-radius: 6px;
        }
    }
    // Inset, clear of the tabs beside it.
    if !root.current && (touch.has-hover || touch.pressed): Rectangle {
        x: 2px;
        y: 4px;
        width: parent.width - 4px;
        height: parent.height - 9px;
        border-radius: 4px;
        background: touch.pressed ? Card.pressed : Card.hover;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.title;
            color: Palette.foreground;
            opacity: root.current ? 1 : 0.75;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
        }
    }

    if root.focused: Rectangle {
        x: 2px;
        y: 3px;
        width: parent.width - 4px;
        height: parent.height - 6px;
        border-radius: 4px;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// The tabs over the pages. Not std-widgets' TabWidget: its fluent tabs keep
// a divider between two tabs until one of them is current, so the divider
// stayed on the edge of the tab under the pointer, over its background.
component TabBar inherits FocusScope {
    in property <[string]> titles;
    in-out property <int> current;
    // A click picks a tab and leaves the focus where it was.
    focus-on-click: false;
    accessible-role: tab-list;
    accessible-item-count: root.titles.length;
    key-pressed(event) => {
        if event.text == Key.LeftArrow {
            root.current = Math.max(root.current - 1, 0);
            return accept;
        }
        if event.text == Key.RightArrow {
            root.current = Math.min(root.current + 1, root.titles.length - 1);
            return accept;
        }
        reject
    }
    // The line the tabs stand on.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Card.stroke;
    }

    HorizontalLayout {
        alignment: start;
        for title[index] in root.titles: TabButton {
            title: title;
            current: index == root.current;
            focused: index == root.current && root.has-focus;
            clicked => {
                root.current = index;
            }
        }
    }
}

component Paragraph inherits StyledText {
    default-color: Palette.foreground;
    link-color: Palette.color-scheme == ColorScheme.dark ? #60cdff : #005fb8;
}

export component SettingsWindow inherits Window {
    in property <string> version;
    // Set when the candidate colors turn the window dark or back.
    in property <ColorScheme> scheme;
    changed scheme => {
        Palette.color-scheme = root.scheme;
    }

    in-out property <string> english-apps;
    in-out property <string> chinese-apps;
    in-out property <bool> symbol-key-on;
    in-out property <string> symbol-key;
    in-out property <string> symbols;
    in-out property <string> swkb;
    in-out property <string> phrases;
    in property <styled-text> symbol-hint;

    in property <[Keybind]> keybinds;
    in property <[string]> actions;
    // For 動作, 參數 and 快捷鍵.
    in property <[styled-text]> keybind-hints;
    callback keybind-action(int, int);
    callback keybind-param(int, string);
    callback keybind-key(int, string);
    callback keybind-remove(int);
    callback keybind-add();

    // The list the picker adds to: 1 英數, 2 中文, 0 none open.
    in property <int> picking;
    in property <[Program]> programs;
    in property <bool> programs-loaded;
    in property <string> programs-error;
    in property <int> picked;
    // Of what the search shows.
    in property <int> pickable;
    in property <bool> all-picked;
    callback open-picker(int);
    callback search-programs(string);
    callback pick-program(int, bool);
    callback pick-all(bool);
    callback add-programs();
    callback close-picker();

    in property <bool> checking;
    in property <string> update-status;
    callback check-update();
    callback open-log-dir();

    callback reset(int);
    callback ok();
    callback cancel();
    callback apply();
    callback import();
    callback export();
    callback open-url(string);

    // The page shown, in the order of the titles.
    in-out property <int> tab;

    title: "InputMethodEditor 設定 (" + root.version + ")";
    preferred-width: 820px;
    // With the title bar, still within a 1080p screen at 150% above the
    // taskbar.
    preferred-height: 600px;
    background: Palette.background;

    // Ctrl+Tab and Ctrl+Shift+Tab go through the pages from wherever the
    // focus is, as in Windows' own property sheets.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.picking != 0 || !event.modifiers.control {
                return reject;
            }
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.tab = Math.mod(root.tab + tab-bar.titles.length - 1, tab-bar.titles.length);
                return accept;
            }
            if event.text == Key.Tab {
                root.tab = Math.mod(root.tab + 1, tab-bar.titles.length);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            tab-bar := TabBar {
                titles: [
                    "打字行為",
                    "各程式",
                    "界面外觀",
                    "鍵盤設定",
                    "拼音",
                    "自訂快捷鍵",
                    "特殊符號",
                    "快捷符號",
                    "自訂詞組",
                    "記錄與備份",
                    "關於",
                ];
                current <=> root.tab;
            }

            // 打字行為
            // Rows grow taller than the window on a small screen.
            if root.tab == 0: ScrollView {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 24px;
                    Column {
                        table: 0;
                    }

                    Column {
                        table: 1;
                    }
                }
            }

            // 各程式
            if root.tab == 1: VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        Label {
                            text: "開啟或切換到這些程式時用英數：";
                        }

                        Editor {
                            text <=> root.english-apps;
                        }

                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "從程式清單加入…";
                                clicked => {
                                    root.open-picker(1);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Label {
                            text: "開啟或切換到這些程式時用中文：";
                        }

                        Editor {
                            text <=> root.chinese-apps;
                        }

                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "從程式清單加入…";
                                clicked => {
                                    root.open-picker(2);
                                }
                            }
                        }
                    }
                }

                Help {
                    text: "每行一個程式的執行檔名稱，例如 chrome.exe、Telegram.exe，可在工作管理員的「詳細資料」頁找到，或按「從程式清單加入」挑選；大小寫不拘，.exe 可省略。在程式裡照樣可以切換，離開再回來就換回這裡的設定。沒列出的程式照舊：記住上次的模式，或依 CapsLock 燈號。用 CapsLock 切換中英文時，會自動按一下 CapsLock 讓燈號對上。";
                }
            }

            // 界面外觀
            // Rows grow taller than the window on a small screen.
            if root.tab == 2: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Column {
                        table: 2;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 24px;
                        Column {
                            table: 3;
                        }

                        Column {
                            table: 4;
                        }
                    }
                }
            }

            // 鍵盤設定
            // Rows grow taller than the window on a small screen.
            if root.tab == 3: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Column {
                        table: 5;
                    }
                }
            }

            // 拼音
            // Rows grow taller than the window on a small screen.
            if root.tab == 4: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    Column {
                        table: 6;
                    }

                    Help {
                        text: "模糊音：分不清的音，打哪一個都找得到兩邊的字，例如勾選 z = zh，打 zong 也有「中」。只在拼音模式作用。";
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        Column {
                            table: 7;
                            follows: true;
                        }

                        Column {
                            table: 8;
                            follows: true;
                        }
                    }
                }
            }

            // 自訂快捷鍵
            if root.tab == 5: VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    KeybindHeader {
                        width: 200px;
                        label: "動作";
                        hint: root.keybind-hints[0];
                    }

                    KeybindHeader {
                        width: 200px;
                        label: "參數";
                        hint: root.keybind-hints[1];
                    }

                    KeybindHeader {
                        width: 200px;
                        label: "快捷鍵";
                        hint: root.keybind-hints[2];
                    }

                    Text {
                        text: "刪除";
                        color: Palette.foreground;
                        font-weight: 600;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                ListView {
                    for keybind[index] in root.keybinds: KeybindRow {
                        item: keybind;
                        actions: root.actions;
                        action(choice) => {
                            root.keybind-action(index, choice);
                        }
                        param(text) => {
                            root.keybind-param(index, text);
                        }
                        key(text) => {
                            root.keybind-key(index, text);
                        }
                        remove => {
                            root.keybind-remove(index);
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "新增快捷鍵";
                        clicked => {
                            root.keybind-add();
                        }
                    }
                }
            }

            // 特殊符號
            if root.tab == 6: VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    CheckBox {
                        text: "中文模式下按這個鍵開啟符號表：";
                        checked <=> root.symbol-key-on;
                        Tooltip {
                            text: root.symbol-hint;
                        }
                    }

                    LineEdit {
                        width: 140px;
                        text <=> root.symbol-key;
                        enabled: root.symbol-key-on;
                    }
                }

                Label {
                    text: "符號表：";
                }

                Editor {
                    text <=> root.symbols;
                }

                Help {
                    text: "以上是符號表的設定檔，語法相當簡單：\n每一行的內容都是：「分類名稱」＝「此分類下的所有符號」\n您也可以一行只放一個符號，則該符號會被放在最上層選單。";
                }
            }

            // 快捷符號
            if root.tab == 7: VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Label {
                    text: "輸入中文時，按下 Shift 鍵（或 Ctrl + Shift）加英文字母即可快速輸入文字：";
                }

                Editor {
                    text <=> root.swkb;
                }

                Help {
                    text: "以上是快捷符號的設定檔，語法相當簡單：\n每一行的內容都是：「大寫字母」＋「空格」＋「對應的符號或文字」。";
                }
            }

            // 自訂詞組
            if root.tab == 8: VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Label {
                    text: "打縮寫再按空白鍵，就換成設定的文字（注音、拼音都可以用）：";
                }

                Editor {
                    text <=> root.phrases;
                }

                Help {
                    text: "每一行是：「縮寫」＋「空格」＋「文字」，縮寫只能用英文字母，例如：\naddr 臺北市信義區市府路 1 號\n縮寫要在沒有組字時開始打；和拼音相同的縮寫（例如 wo）會取代原本的字。# 開頭的行是註解。";
                }
            }

            // 記錄與備份
            // Rows grow taller than the window on a small screen.
            if root.tab == 9: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    Column {
                        table: 10;
                    }

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "開啟記錄檔資料夾";
                            clicked => {
                                root.open-log-dir();
                            }
                        }
                    }

                    Header {
                        label: "設定檔";
                    }

                    Help {
                        text: "把這裡的設定存成一個檔案，搬到另一台電腦或留作備份。匯出的是目前畫面上的設定，包括還沒套用的變更；匯入後按「確定」或「套用」才會生效。";
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Button {
                            text: "匯入設定檔…";
                            clicked => {
                                root.import();
                            }
                        }

                        Button {
                            text: "匯出設定檔…";
                            clicked => {
                                root.export();
                            }
                        }
                    }
                }
            }

            // 關於, with the updates as on Chrome's.
            if root.tab == 10: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 16px;
                        padding-bottom: 8px;
                        Image {
                            source: @image-url("logo.svg");
                            width: 96px;
                            height: 96px;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "InputMethodEditor";
                                color: Palette.foreground;
                                font-size: 20px;
                                font-weight: 600;
                            }

                            Paragraph {
                                text: @markdown("版本 \{root.version}・授權方式 GPL-3.0-or-later");
                            }

                            Paragraph {
                                text: @markdown("專案首頁：[GitHub](https://github.com/linzeyan/InputMethodEditor)");
                                link-clicked(url) => {
                                    root.open-url(url);
                                }
                            }
                        }
                    }

                    Paragraph {
                        text: @markdown("核心是新酷音（libchewing）。這個設定程式改自 windows-chewing-preferences，原作者為新酷音開發團隊（Chewing Project Authors），詳見 [https://chewing.im](https://chewing.im)。");
                        link-clicked(url) => {
                            root.open-url(url);
                        }
                    }

                    Column {
                        table: 9;
                        follows: true;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;
                        Button {
                            text: "立即檢查更新";
                            enabled: !root.checking;
                            clicked => {
                                root.check-update();
                            }
                        }

                        Label {
                            text: root.update-status;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                // 各程式 and 自訂詞組 are the user's own, with nothing to go back to.
                Button {
                    text: "還原此頁預設值";
                    enabled: root.tab != 1 && root.tab != 8;
                    clicked => {
                        root.reset(root.tab);
                    }
                }

                Rectangle { }

                Button {
                    text: "確定";
                    clicked => {
                        root.ok();
                    }
                }

                Button {
                    text: "取消";
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    text: "套用";
                    clicked => {
                        root.apply();
                    }
                }
            }
        }
    }

    // The program picker, over the settings, which its backdrop keeps from
    // being clicked meanwhile.
    if root.picking != 0: Rectangle {
        property <bool> all-picked: root.all-picked;
        changed all-picked => {
            all.checked = self.all-picked;
        }
        width: 100%;
        height: 100%;
        background: #00000066;
        TouchArea { }

        Rectangle {
            width: min(560px, parent.width - 48px);
            height: min(600px, parent.height - 48px);
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            VerticalLayout {
                padding: 24px;
                spacing: 8px;
                Text {
                    text: root.picking == 1 ? "開啟或切換到時用英數的程式" : "開啟或切換到時用中文的程式";
                    color: Palette.foreground;
                    font-size: 20px;
                    font-weight: 600;
                }

                LineEdit {
                    placeholder-text: "搜尋名稱或執行檔";
                    edited(text) => {
                        root.search-programs(text);
                    }
                }

                // Heads the column of checkboxes it acts on.
                all := CheckBox {
                    text: "全選";
                    enabled: root.pickable > 0;
                    toggled => {
                        root.pick-all(self.checked);
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                if !root.programs-loaded: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Spinner {
                        indeterminate: true;
                        width: 20px;
                        height: 20px;
                    }

                    Label {
                        text: "正在讀取程式清單…";
                    }
                }

                if root.programs-error != "": Help {
                    text: "無法讀取程式清單：" + root.programs-error;
                }

                // Not a ListView, which drew every row at the top: its rows'
                // height depends on the search, which a layout follows.
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for program[index] in root.programs: PickRow {
                            item: program;
                            toggled(on) => {
                                root.pick-program(index, on);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    Button {
                        text: root.picked > 0 ? "加入 \{root.picked} 個" : "加入";
                        primary: true;
                        enabled: root.picked > 0;
                        clicked => {
                            root.add-programs();
                        }
                    }

                    Button {
                        text: "取消";
                        clicked => {
                            root.close-picker();
                        }
                    }
                }
            }
        }
    }
}
