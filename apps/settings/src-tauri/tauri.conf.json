{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InputMethodEditor 設定",
  "identifier": "io.github.linzeyan.InputMethodEditor.Settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "InputMethodEditor 設定",
        "width": 790,
        "height": 750,
        "resizable": true,
        "visible": false,
        "maximizable": false,
        "windowEffects": { "effects": ["mica"] }
      },
      {
        "label": "about",
        "parent": "main",
        "url": "index.html#about",
        "title": "關於 InputMethodEditor",
        "width": 430,
        "height": 400,
        "resizable": true,
        "visible": false,
        "closable": false,
        "maximizable": false,
        "minimizable": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": null
    }
  }
}
